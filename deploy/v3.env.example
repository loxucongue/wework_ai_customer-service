AI_PATHS_SERVICE_ROLE=reply
AI_PATHS_BACKGROUND_WORKERS_ENABLED=false
AI_PATHS_RELEASE_ID=replace-with-release-id
AI_PATHS_BUILD_GIT_COMMIT=replace-with-full-git-commit
AI_PATHS_BUILD_DIRTY=false
V3_EVALUATION_DIR=/opt/ai-paths-v3/evaluations
# V3 customer-path budgets are independent from worker/model maintenance jobs.
V3_TAKEOVER_TIMEOUT_SECONDS=12
V3_REPLY_ROUND_TIMEOUT_SECONDS=25
V3_REPLY_STRONG_ROUND_TIMEOUT_SECONDS=35
V3_REPLY_RESERVE_SECONDS=10
V3_REPLY_MIN_RETRY_REMAINING_SECONDS=4
# Keep disabled until the deployment has an authenticated, required delivery
# callback contract; otherwise a recovery send cannot be confirmed safely.
V3_REPLY_RECOVERY_ENABLED=false
V3_REPLY_RECOVERY_POLL_SECONDS=5
V3_REPLY_RECOVERY_BATCH_SIZE=5
V3_REPLY_RECOVERY_MAX_ATTEMPTS=2
V3_REPLY_MAX_MESSAGES=8
V3_REPLY_MAX_TEXT_CHARS=300
V3_REPLY_TEMPERATURE=0.15
FOLLOW_KNOWLEDGE_CACHE_TTL_SECONDS=300
# Use an independent provider only after the primary relay returns no valid
# Tool Planner or Reply payload. Provider credentials stay in the shared env.
MODEL_SECONDARY_PROVIDER=aliyun
MODEL_SECONDARY=qwen-plus
MODEL_SECONDARY_TIMEOUT_SECONDS=20
# Keep customer-visible SOP bodies in the shared online config. This overlay
# supplies code-owned V3 asset roles and retrieval boundaries only.
SOP_REPLY_PACKS_OVERLAY_PATH=/opt/ai-paths-v3/current/config/sop_asset_overlay.json
