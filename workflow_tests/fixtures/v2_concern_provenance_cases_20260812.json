{
  "version": "2026-08-12",
  "purpose": "V2 顾虑来源与提问价值专项：禁止主动植入新顾虑，同时保留客户主动提问时的准确回答能力。",
  "defaults": {
    "initial": {
      "customer": {"name": "仿真客户"},
      "case_facts": [
        {
          "case_id": "sim_case_spot_01",
          "summary": "门店顾客斑点改善原相机对比参考",
          "image_url": "https://example.invalid/simulation/case-spot-01.jpg"
        }
      ]
    }
  },
  "scenarios": [
    {
      "id": "trust_doubt_does_not_invent_fee_concern",
      "category": "顾虑来源",
      "critical": true,
      "semantic_goal": "客户只质疑效果真假时，先用真实案例和原相机证据建立信任，不主动提出隐形收费、退款、反弹、副作用或其他新顾虑，也不让客户在多个潜在顾虑中二选一。",
      "expected": {
        "must_reply": true,
        "forbidden_phrases": ["隐形收费", "隐形消费", "还是怕", "还是担心", "退款", "反弹", "副作用", "不给您说太满", "不能说太满", "发我看下", "发照片", "强制加项目", "费用都是提前说明", "您如果更在意", "我也可以继续", "我也可以接着", "我可以接着", "您要是主要担心", "您在意的是", "要是您在意", "脸上还是手上", "脸还是手", "全脸还是局部", "哪个部位"]
      },
      "initial": {
        "conversation": [
          "小贝: 我先给您介绍一下这边淡斑改善的情况。"
        ]
      },
      "timeline": [
        {"kind": "customer_message", "content": "不知道是真的还是假的"}
      ]
    },
    {
      "id": "past_bad_result_advances_without_new_diagnosis",
      "category": "顾虑来源",
      "critical": true,
      "semantic_goal": "客户明确讲过去做完斑更多，简短承接这段经历并按当前权威效果口径增强信心，然后可以推进真实案例或活动；不得制造改善明显还是新长、反弹还是加重等无决策价值二选一。",
      "expected": {
        "must_reply": true,
        "forbidden_phrases": ["改善明显了，还是", "又新长出来", "反弹还是", "加重还是", "您更在意", "不会乱保证", "如果您担心", "我可以直接跟您说", "如果您愿意", "我再接着给您说"]
      },
      "initial": {
        "conversation": [
          "用户: 不知道是真的还是假的",
          "小贝: 我们发的是门店顾客做前做后的原相机对比，到店也会给您留对比记录。"
        ]
      },
      "timeline": [
        {"kind": "customer_message", "content": "我过年做过祛斑的，现在比不做更多了，头疼死我了"}
      ]
    },
    {
      "id": "face_total_price_does_not_invent_scope_ambiguity",
      "category": "顾虑来源",
      "critical": true,
      "semantic_goal": "客户在脸部淡斑上下文中只问总价，直接回答当前脸部活动总价和权威包含范围；不主动追问全脸还是局部，不提手部、手脸组合或多部位价格。",
      "expected": {
        "must_reply": true,
        "forbidden_types": ["payment_collection"],
        "forbidden_phrases": ["全脸还是局部", "局部还是全脸", "手部", "手和脸", "两个部位", "哪一个部位"]
      },
      "initial": {
        "conversation": [
          "用户: 我脸上的斑越来越明显",
          "小贝: 现在周年庆脸部淡斑活动总价268元，包含淡斑、皮肤检测、基础清洁和肌肤补水。"
        ],
        "completed_sops": ["s10_activity_intro"]
      },
      "timeline": [
        {"kind": "customer_message", "content": "总共做完的话要多少钱呢"}
      ]
    },
    {
      "id": "explicit_hidden_fee_question_still_answered",
      "category": "顾虑来源",
      "critical": true,
      "semantic_goal": "客户主动询问隐形消费时，必须正面回答活动范围和费用透明，不能因为顾虑来源限制而回避问题；首次费用确认不直接发预约金卡。",
      "expected": {
        "must_reply": true,
        "forbidden_types": ["payment_collection"]
      },
      "initial": {
        "conversation": [
          "小贝: 现在周年庆脸部淡斑活动总价268元，包含淡斑、皮肤检测、基础清洁和肌肤补水。"
        ]
      },
      "timeline": [
        {"kind": "customer_message", "content": "去了不会再有隐形消费吧"}
      ]
    },
    {
      "id": "explicit_rebound_question_still_answered",
      "category": "顾虑来源",
      "critical": true,
      "semantic_goal": "客户主动问反弹时，按当前批准效果口径正面给信心，不回避、不主动扩展其他风险。",
      "expected": {"must_reply": true},
      "timeline": [
        {"kind": "customer_message", "content": "做完以后会不会反弹"}
      ]
    },
    {
      "id": "explicit_hand_face_scope_still_answered",
      "category": "顾虑来源",
      "critical": true,
      "semantic_goal": "客户主动问手和脸是否一个总价时，准确说明一个268对应一个部位且不能提前承诺同次完成；不能把两个部位当成两位客户或发20元卡。",
      "expected": {
        "must_reply": true,
        "forbidden_types": ["payment_collection"]
      },
      "timeline": [
        {"kind": "customer_message", "content": "手和脸一起是不是总共268"}
      ]
    }
  ]
}
