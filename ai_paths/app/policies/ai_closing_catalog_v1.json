{
  "schema_version": "ai_closing_catalog_v1",
  "catalog_version": "2026-09-04.real-scenes-v1",
  "business_status": "provisional",
  "description": "业务接口未完成期间使用的逼单规则、策略和话术目录。只提供候选，不替代 V3 Reply 的最终语义决策。",
  "rules": {
    "triggers": [
      {
        "rule_key": "local:rule:recognized_pending_time",
        "source_id": "recognized_pending_time",
        "type_name": "已认可方案但还没确定到店时间",
        "condition": "客户明确认可项目方向、主要效果或费用说明，当前没有继续追问价格、效果、距离、安全等问题，只差确定大致到店时间。",
        "judge_method": "AI结合上下文判断",
        "trigger_mode": "independent",
        "locked": false,
        "keywords": ["可以去看看", "过几天去", "周末可能有空", "这个方案可以"],
        "judge_note": "必须有明确认可或继续信号；主要卡点已回答；订单未支付且未预约。只有考虑一下、晚点再说而没有继续意愿时不命中。",
        "grouping_supported": true
      },
      {
        "rule_key": "local:rule:store_accepted",
        "source_id": "store_accepted",
        "type_name": "已接受真实门店并愿意到店",
        "condition": "系统已查到真实门店，客户明确表示该门店可以去、愿意过去了解或主动询问营业时间，当前只差确认时间或预约。",
        "judge_method": "AI结合门店工具事实判断",
        "trigger_mode": "independent",
        "locked": false,
        "keywords": ["这家可以", "离我不远", "我过去看看", "你们几点营业"],
        "judge_note": "门店必须来自实时工具；客户只是问地址、仍表示太远或门店尚未核实时不命中。",
        "grouping_supported": true
      },
      {
        "rule_key": "local:rule:visit_time_provided",
        "source_id": "visit_time_provided",
        "type_name": "已明确到店日期或时段但还没预约",
        "condition": "客户本人已经给出今天、明天、周末、某个日期或上午下午等到店时间，主要问题已解决，但系统显示预约尚未完成。",
        "judge_method": "AI结合预约事实判断",
        "trigger_mode": "independent",
        "locked": false,
        "keywords": ["明天下午去", "周六有时间", "月底过去", "下午三点左右可以"],
        "judge_note": "时间必须由客户本人提出；门店和营业时间真实可用；已经预约或真实档期未知时不命中。",
        "grouping_supported": true
      },
      {
        "rule_key": "local:rule:blocker_resolved_continue",
        "source_id": "blocker_resolved_continue",
        "type_name": "原有卡点已解决并明确愿意继续",
        "condition": "客户此前对预约金、费用、效果或距离存在顾虑，相关问题已按真实事实解释，客户随后明确表示理解、接受、可以继续或愿意办理下一步。",
        "judge_method": "AI结合前后轮证据判断",
        "trigger_mode": "independent",
        "locked": false,
        "keywords": ["这样可以", "明白了", "那就预约吧", "可以继续登记", "这个门店能去"],
        "judge_note": "必须有客户在解释后的继续信号；销售单方面认为已解决、客户沉默或出现新卡点时不命中。",
        "grouping_supported": true
      },
      {
        "rule_key": "local:rule:defer_with_return_intent",
        "source_id": "defer_with_return_intent",
        "type_name": "时间不方便但明确保留后续到店意愿",
        "condition": "客户认可项目和到店方向，只因工作、照顾家人、出行或临时安排现在无法到店，并明确表示之后会来或同意在某个时间再联系。",
        "judge_method": "AI结合上下文判断",
        "trigger_mode": "independent",
        "locked": false,
        "keywords": ["这周忙下周再约", "月底有空再过去", "过几天你再联系我", "等家里安排好就去"],
        "judge_note": "必须有明确后续意愿或回访授权；只说忙、以后再说、考虑一下时不命中，也不能在本轮强推预约或付款。",
        "grouping_supported": true
      }
    ],
    "ai_confirm": {
      "enabled": true,
      "guidance": "关键词只作线索。必须同时核对当前客户原话、未解决卡点、订单/预约事实以及退订、投诉、健康风险和人工接管状态。"
    },
    "constraints": {
      "max_per_day": 2,
      "min_interval_minutes": 30,
      "prerequisites": [
        {"key": "local:prerequisite:customer_progress_signal", "text": "客户当前有明确继续、到店或允许后续联系的信号"},
        {"key": "local:prerequisite:no_unresolved_blocker", "text": "客户当前没有仍未解决的新卡点"}
      ],
      "taboos": [
        {"key": "local:taboo:explicit_opt_out", "text": "客户明确要求不要联系或停止发送"},
        {"key": "local:taboo:complaint_or_anger", "text": "客户正在投诉、愤怒或要求人工处理"},
        {"key": "local:taboo:health_risk", "text": "客户存在需要先处理的健康或安全风险"},
        {"key": "local:taboo:transaction_terminal", "text": "客户已经支付、预约成功或进入交易终态"}
      ]
    }
  },
